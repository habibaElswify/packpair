# PackPair environment variables (template — copy to .env / .env.local, never commit real values)

# ───────────────────────── FastAPI solver service (Render) ─────────────────────────
# Comma-separated front-end origins allowed to call the API.
PACKPAIR_CORS_ORIGINS=http://localhost:3000,https://habibaelswify.github.io
# Supabase service-role key (server-side only — full DB access). KEEP SECRET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ───────────────────────── Next.js front-end (Vercel) ─────────────────────────
# These NEXT_PUBLIC_* values are exposed to the browser (safe to be public).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL of the deployed FastAPI solver service (Render), e.g. https://packpair-solver.onrender.com
NEXT_PUBLIC_SOLVER_API_URL=http://localhost:8000
